# ===== 社区智慧养老平台 环境配置示例 =====
# 复制为 .env 后按需修改；不提交 .env 到仓库
APP_NAME=社区智慧养老服务与健康监测平台
ENV=dev
SECRET_KEY=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 数据库（SQLite 演示 / PostgreSQL 生产）
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/eldercare

# 上传与备份目录（相对项目根目录）
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups

# 敏感字段加密密钥（32 字节 base64；生产必须替换）
ENCRYPTION_KEY=ZGV2LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0zMi1i
FIELD_HASH_KEY=dev-hash-key-change-me

# 定时任务
ENABLE_SCHEDULER=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# 派单权重（技能/距离/负荷/评分），逗号分隔，合计为 1
DISPATCH_WEIGHTS=0.4,0.3,0.2,0.1
DISPATCH_TOP_N=3
ORDER_DAILY_LIMIT=6
SERVICE_RADIUS_KM=3
NURSE_RATING_DEFAULT=3.5

# 服务执行
CHECKIN_DISTANCE_THRESHOLD_M=200
PHOTO_LIMIT=3
PHOTO_MAX_KB=2048
PHOTO_UPLOAD_MAX_MB=10
PHOTO_MAX_PIXELS=20000000
ACCEPT_TIMEOUT_MINUTES=30
CANCEL_FREE_HOURS=2
DURATION_ANOMALY_MINUTES=30

# 预警
ALERT_RED_PUSH_MINUTES=5
ALERT_ESCALATE_MINUTES=30
ALERT_SILENCE_HOURS=48
ALERT_COOLDOWN_MINUTES=30

# 结算
DIFF_RATIO_THRESHOLD=0.01
AUDIT_RETENTION_DAYS=180
BACKUP_KEEP_VERSIONS=30
